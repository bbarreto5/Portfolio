---
// Cierre de la historia: el hero empieza de día, el contacto termina al atardecer.
import { profile, type Content } from '../data/profile';
import Palm from './scene/Palm.astro';

interface Props {
  t: Content;
}
const { t } = Astro.props;
---

<section class="contact" id="contacto" aria-labelledby="contact-title">
  <div class="contact__sky" aria-hidden="true">
    <div class="contact__sun"></div>
  </div>

  <div class="wrap contact__inner">
    <p class="kicker" data-reveal>{t.contact.kicker}</p>
    <h2 id="contact-title" class="contact__title" data-reveal>{t.contact.title}</h2>
    <p class="contact__text" data-reveal>{t.contact.text}</p>

    <div class="contact__mail" data-reveal>
      <a class="contact__email" href={`mailto:${profile.email}`}>
        <span class="sr-only">{t.contact.email}: </span>{profile.email}
      </a>
      <button class="btn btn--ghost contact__copy" type="button" data-copy={profile.email} data-copied-label={t.contact.copied}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
        <span data-copy-label>{t.contact.copy}</span>
      </button>
    </div>

    <ul class="contact__links" data-reveal>
      <li>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer me">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm7 0h3.8v1.5h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1v5.46h-4v-4.84c0-1.16-.02-2.64-1.6-2.64-1.62 0-1.86 1.26-1.86 2.56v4.92H10v-11Z"></path></svg>
          {t.contact.linkedin}
          <span class="sr-only">{t.contact.newTab}</span>
        </a>
      </li>
      <li>
        <a class="btn btn--ghost" href={profile.github} target="_blank" rel="noopener noreferrer me">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path></svg>
          {t.contact.github}
          <span class="sr-only">{t.contact.newTab}</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="contact__sea" aria-hidden="true">
    <div class="contact__glow"></div>
    <svg class="contact__palm" viewBox="-110 -260 220 270" focusable="false">
      <Palm x={0} y={0} scale={1} lean={-24} delay={-1} />
    </svg>
  </div>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p>{t.footer.made} <span class="footer__from">{t.footer.from}</span></p>
      <p class="footer__meta">
        <span>{profile.origin.coords}</span>
        <span>© {new Date().getFullYear()}</span>
        <a href="#top">{t.footer.top} ↑</a>
      </p>
    </div>
  </footer>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    const original = label?.textContent ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = btn.dataset.copiedLabel ?? original;
        setTimeout(() => label && (label.textContent = original), 2000);
      } catch {
        window.location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  });
</script>

<style>
  .contact {
    position: relative;
    background: var(--coral);
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }
  .contact__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(0deg, transparent 0 40px, rgb(255 200 61 / 0.25) 40px 48px);
  }
  .contact__sun {
    position: absolute;
    right: 12%;
    bottom: 150px;
    width: clamp(180px, 26vw, 360px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun);
    border: var(--outline-thick) solid var(--ink);
    translate: 0 50%;
  }
  .contact__inner {
    position: relative;
    z-index: 1;
    padding-top: var(--section-y);
    padding-bottom: clamp(48px, 7vw, 80px);
  }
  .contact__title {
    margin-top: 14px;
    max-width: 14ch;
    font-size: clamp(2.6rem, 1.5rem + 5vw, 5.8rem);
    line-height: 0.95;
    color: var(--cream);
    -webkit-text-stroke: 0.05em var(--ink);
    paint-order: stroke fill;
    text-shadow: 0.05em 0.05em 0 var(--ink);
  }
  .contact__text {
    margin-top: 18px;
    font-size: 1.15em;
    font-weight: 600;
  }
  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
    margin-top: 32px;
  }
  .contact__email {
    font-size: clamp(1.15rem, 0.8rem + 1.9vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 6px;
    text-decoration-color: var(--cream);
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.2s;
  }
  .contact__email:hover {
    text-decoration-color: var(--ink);
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }

  .contact__sea {
    position: relative;
    height: 150px;
    background: var(--sea-6);
    border-top: var(--outline) solid var(--ink);
  }
  /* reflejo del sol sobre el agua */
  .contact__glow {
    position: absolute;
    top: 14px;
    right: 12%;
    width: clamp(180px, 26vw, 360px);
    height: 96px;
    background: repeating-linear-gradient(180deg, var(--sun) 0 7px, transparent 7px 22px);
    clip-path: polygon(8% 0, 92% 0, 66% 100%, 34% 100%);
    animation: bob 4s ease-in-out infinite;
  }
  .contact__palm {
    position: absolute;
    right: max(var(--gutter), 2%);
    bottom: 100%;
    width: clamp(120px, 13vw, 180px);
    overflow: visible;
  }

  .footer {
    background: var(--sea-7);
    color: var(--cream);
    border-top: var(--outline) solid var(--ink);
    font-size: 0.9rem;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    padding-block: 26px 30px;
  }
  .footer__from {
    opacity: 0.75;
  }
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .footer__meta a {
    color: var(--sun);
  }

  @media (max-width: 720px) {
    .contact__sun,
    .contact__glow {
      right: -12%;
    }
    .contact__palm {
      right: auto;
      left: var(--gutter);
    }
    /* deja espacio para la barra de navegación inferior */
    .footer__inner {
      padding-bottom: 110px;
    }
  }
</style>
