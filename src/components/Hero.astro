---
import { profile, type Content } from '../data/profile';
import SeaBands from './scene/SeaBands.astro';
import Cay from './scene/Cay.astro';
import Cloud from './scene/Cloud.astro';
import Satellite from './scene/Satellite.astro';
import Porthole from './scene/Porthole.astro';

interface Props {
  t: Content;
}
const { t } = Astro.props;

// Glifos de código flotando en el cielo, como el confeti geométrico de la referencia.
const glyphs = [
  { g: '{ }', x: 6, y: 18, r: -12, s: 1.4 },
  { g: '</>', x: 44, y: 9, r: 8, s: 1.1 },
  { g: '=>', x: 30, y: 30, r: -6, s: 0.9, desk: true },
  { g: '//', x: 62, y: 38, r: 14, s: 1, desk: true },
  { g: '[ ]', x: 90, y: 8, r: -10, s: 1.2 },
  { g: '$_', x: 52, y: 22, r: 4, s: 0.9, desk: true },
  { g: '01', x: 16, y: 6, r: 10, s: 0.85 },
];

const codeLoop = 'git push origin main · flutter build ios · nest start · gcloud pubsub topics publish · next build · airflow dags trigger · ';
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__sky" aria-hidden="true">
    <div class="hero__sun"></div>
    <div class="hero__clouds">
      <Cloud class="cloud cloud--1" />
      <Cloud class="cloud cloud--2" />
      <Cloud class="cloud cloud--3" />
    </div>
    {
      glyphs.map((g) => (
        <span class:list={['glyph', { 'glyph--desk': g.desk }]} style={`--x:${g.x}%;--y:${g.y}%;--r:${g.r}deg;--s:${g.s}`}>
          {g.g}
        </span>
      ))
    }
  </div>

  <div class="hero__inner wrap">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12Z" fill="var(--coral)" stroke="var(--ink)" stroke-width="2.2"></path><circle cx="12" cy="10" r="2.6" fill="var(--cream)" stroke="var(--ink)" stroke-width="2"></circle></svg>
        <span>{t.hero.eyebrow}</span>
        <span class="hero__coords">{profile.origin.coords}</span>
      </p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">Brandon<br />Barreto Lozano</span>
        <span class="hero__role">{t.hero.role}</span>
      </h1>
      <p class="hero__tagline">{t.hero.tagline}</p>
      <div class="hero__ctas">
        <a class="btn" href="#expediciones">
          {t.hero.ctaProjects}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
        </a>
        <a class="btn btn--ghost" href="#contacto">
          {t.hero.ctaContact}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16v12H4z"></path><path d="m4 7 8 6 8-6"></path></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="hero__scene">
    <SeaBands class="hero__sea" />
    <div class="hero__sat" aria-hidden="true"><Satellite /></div>

    <div class="hero__portrait">
      <svg class="hero__ribbon" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
        <defs>
          <path id="ribbon-path" d="M 61 280 A 160 160 0 1 1 339 280"></path>
        </defs>
        <use href="#ribbon-path" fill="none" stroke="var(--ink)" stroke-width="34" stroke-linecap="round"></use>
        <use href="#ribbon-path" fill="none" stroke="var(--sea-2)" stroke-width="27" stroke-linecap="round"></use>
        <text class="hero__ribbon-text" dy="4.5">
          <textPath href="#ribbon-path" startOffset="0">
            {codeLoop.repeat(3)}
            <animate attributeName="startOffset" from="0" to="-707" dur="28s" repeatCount="indefinite"></animate>
          </textPath>
        </text>
      </svg>
      <Porthole class="hero__porthole" alt={t.hero.photoAlt} pendingLabel={t.hero.photoPending} />
    </div>

    <div class="hero__terminal" aria-hidden="true">
      <div class="hero__terminal-bar"><i></i><i></i><i></i></div>
      <pre>{t.hero.terminal.map((line) => (line.startsWith('$') ? <span class="cmd">{line}</span> : <span>{line}</span>))}</pre>
    </div>

    <Cay class="hero__cay" />
  </div>

  <svg class="hero__shore" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="hero__shore-wave" d="M0 30 Q 90 6 180 30 T 360 30 T 540 30 T 720 30 T 900 30 T 1080 30 T 1260 30 T 1440 30 T 1620 30 T 1800 30 T 1980 30 T 2160 30 T 2340 30 T 2520 30 T 2700 30 T 2880 30 V 60 H 0 Z" fill="var(--sand)" stroke="var(--ink)" stroke-width="3" vector-effect="non-scaling-stroke"></path>
  </svg>
</section>

<style>
  .hero {
    --hero-p: 0;
    position: relative;
    min-height: max(760px, 100svh);
    background: var(--sky);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- Cielo ---------- */
  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translateY(calc(var(--hero-p) * 60px));
  }
  .hero__sun {
    position: absolute;
    right: 18%;
    top: 9%;
    width: clamp(120px, 15vw, 220px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, #ffe28a 0 52%, var(--sun) 53%);
    border: var(--outline-thick) solid var(--ink);
  }
  .hero__clouds :global(.cloud) {
    position: absolute;
    width: clamp(110px, 13vw, 200px);
    animation: drift linear infinite;
  }
  .hero__clouds :global(.cloud--1) {
    top: 12%;
    animation-duration: 95s;
    animation-delay: -30s;
  }
  .hero__clouds :global(.cloud--2) {
    top: 26%;
    width: clamp(80px, 9vw, 140px);
    animation-duration: 120s;
    animation-delay: -80s;
  }
  .hero__clouds :global(.cloud--3) {
    top: 5%;
    width: clamp(70px, 7vw, 110px);
    animation-duration: 140s;
    animation-delay: -10s;
  }
  .glyph {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: calc(var(--s) * clamp(1.2rem, 2.2vw, 2.2rem));
    color: var(--cream);
    opacity: 0.75;
    transform: rotate(var(--r));
    text-shadow: 2px 2px 0 color-mix(in srgb, var(--ink) 25%, transparent);
    animation: bob 7s ease-in-out infinite;
    animation-delay: calc(var(--r) * -0.3s);
  }

  /* ---------- Texto ---------- */
  .hero__inner {
    position: relative;
    z-index: 3;
    padding-top: clamp(118px, 15vh, 170px);
  }
  .hero__copy {
    max-width: min(620px, 52%);
  }
  .hero__eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    padding: 6px 14px 6px 8px;
    background: var(--cream);
    border: var(--outline) solid var(--ink);
    border-radius: 999px;
    box-shadow: var(--shadow-cel-sm);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .hero__eyebrow svg {
    width: 22px;
    height: 22px;
  }
  .hero__coords {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .hero__title {
    margin-top: 22px;
  }
  .hero__name {
    display: block;
    font-size: clamp(2.9rem, 1.5rem + 5.6vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    color: var(--cream);
    -webkit-text-stroke: 0.06em var(--ink);
    paint-order: stroke fill;
    text-shadow: 0.06em 0.06em 0 var(--ink);
  }
  .hero__role {
    display: block;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 0.75rem + 0.3vw, 1rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.5;
  }
  .hero__tagline {
    margin-top: 14px;
    max-width: 40ch;
    font-size: clamp(1.08rem, 1rem + 0.45vw, 1.35rem);
    font-weight: 550;
    line-height: 1.45;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  /* ---------- Escena ---------- */
  .hero__scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero :global(.hero__sea) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 54%;
    transform: translateY(calc(var(--hero-p) * -30px));
  }
  .hero__sat {
    position: absolute;
    left: 50%;
    top: 13%;
    width: clamp(90px, 10vw, 150px);
    transform: translateY(calc(var(--hero-p) * 90px));
  }
  .hero__portrait {
    position: absolute;
    right: max(var(--gutter), 6%);
    top: 17%;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }
  .hero__ribbon {
    position: absolute;
    width: 172%;
    max-width: none;
    aspect-ratio: 1;
    left: 50%;
    top: 50%;
    translate: -50% -48%;
  }
  .hero__ribbon-text {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }
  .hero :global(.hero__porthole) {
    position: relative;
    animation: bob 6s ease-in-out infinite;
  }
  .hero__terminal {
    position: absolute;
    right: calc(max(var(--gutter), 6%) + clamp(170px, 23vw, 320px));
    top: 35%;
    z-index: 2;
    width: 230px;
    background: var(--ink);
    color: var(--cream);
    border: var(--outline) solid var(--ink);
    border-radius: 12px;
    box-shadow: 5px 5px 0 var(--sea-6);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    animation: bob 5s ease-in-out -1.5s infinite;
  }
  .hero__terminal-bar {
    display: flex;
    gap: 5px;
    padding: 7px 9px;
    background: var(--cream);
    border-radius: 8px 8px 0 0;
  }
  .hero__terminal-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--coral);
  }
  .hero__terminal-bar i:nth-child(2) {
    background: var(--sun);
  }
  .hero__terminal-bar i:nth-child(3) {
    background: var(--palm);
  }
  .hero__terminal pre {
    margin: 0;
    padding: 10px 12px 12px;
    font: inherit;
    line-height: 1.7;
    white-space: pre-wrap;
  }
  .hero__terminal span {
    display: block;
  }
  .hero__terminal .cmd {
    color: var(--sea-2);
  }
  .hero__terminal span:last-child::after {
    content: '▋';
    margin-left: 4px;
    color: var(--sun);
    animation: blink 1.1s steps(1) infinite;
  }
  .hero :global(.hero__cay) {
    position: absolute;
    right: 2%;
    bottom: 3%;
    width: min(46vw, 640px);
    transform: translateY(calc(var(--hero-p) * -50px));
  }

  /* ---------- Orilla ---------- */
  .hero__shore {
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 44px;
    z-index: 2;
    overflow: hidden;
  }
  .hero__shore-wave {
    animation: wave-x 22s linear infinite;
  }

  /* ---------- Laptop bajo / tablet horizontal ---------- */
  @media (max-width: 1100px) {
    .hero__terminal {
      display: none;
    }
    .hero__copy {
      max-width: 56%;
    }
  }

  /* ---------- Tablet / mobile: escena en vertical ---------- */
  @media (max-width: 820px) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .hero__inner {
      padding-top: 96px;
    }
    .hero__copy {
      max-width: none;
    }
    .glyph--desk {
      display: none;
    }
    .hero__sun {
      right: 6%;
      top: 7%;
      width: 110px;
    }
    .hero__scene {
      position: relative;
      inset: auto;
      height: clamp(430px, 100vw, 620px);
      margin-top: 8px;
    }
    .hero :global(.hero__sea) {
      height: 74%;
    }
    .hero__sat {
      left: auto;
      right: 8%;
      top: 2%;
      width: 96px;
    }
    .hero__portrait {
      right: auto;
      left: max(var(--gutter), 10%);
      top: 9%;
    }
    .hero :global(.hero__porthole) {
      --size: clamp(130px, 30vw, 200px);
    }
    .hero__terminal {
      display: block;
      right: var(--gutter);
      top: 34%;
      width: min(200px, 46vw);
      font-size: 0.66rem;
    }
    .hero :global(.hero__cay) {
      left: 50%;
      right: auto;
      bottom: 4%;
      width: min(108vw, 640px);
      translate: -50% 0;
    }
  }

  @media (max-width: 480px) {
    .hero__coords {
      display: none;
    }
    .hero__ctas {
      gap: 10px;
    }
    .hero__ctas .btn {
      padding: 12px 18px;
      font-size: 0.95rem;
    }
    .hero__terminal {
      top: 30%;
    }
    .hero__terminal pre {
      padding: 8px 10px;
    }
  }
</style>
