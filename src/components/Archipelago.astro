---
import { archipelago, type Content } from '../data/profile';

interface Props {
  t: Content;
}
const { t } = Astro.props;

// Siluetas de islote (originales) y su color de vegetación, una por cayo.
const shapes: Record<string, { d: string; fill: string }> = {
  mobile: { d: 'M20 46 C 22 22, 70 12, 104 20 C 140 28, 158 50, 140 66 C 118 84, 46 84, 24 70 C 16 64, 18 54, 20 46 Z', fill: 'var(--palm)' },
  frontend: { d: 'M14 50 C 10 30, 40 14, 78 18 C 120 22, 162 34, 156 56 C 150 78, 100 86, 60 80 C 30 76, 16 66, 14 50 Z', fill: 'var(--sun)' },
  backend: { d: 'M10 54 C 6 26, 52 8, 96 12 C 140 16, 168 34, 162 58 C 156 82, 112 90, 70 86 C 34 82, 12 74, 10 54 Z', fill: 'var(--palm-dark)' },
  cloud: { d: 'M22 52 C 18 32, 50 18, 84 22 C 116 26, 150 30, 146 54 C 142 76, 104 82, 70 80 C 40 78, 24 68, 22 52 Z', fill: 'var(--cream)' },
  data: { d: 'M18 56 C 14 36, 44 20, 74 26 C 94 30, 118 16, 142 30 C 164 44, 150 74, 116 80 C 80 86, 26 80, 18 56 Z', fill: 'var(--coral)' },
  gis: { d: 'M16 48 C 18 24, 58 14, 92 22 C 128 30, 154 42, 148 62 C 140 82, 84 86, 50 78 C 26 72, 14 64, 16 48 Z', fill: 'var(--palm)' },
  devops: { d: 'M12 40 H 150 V 62 H 12 Z', fill: 'var(--wood)' },
};
---

<section class="arch section" id="archipielago" aria-labelledby="arch-title" data-filter="all">
  <div class="wrap">
    <header class="arch__head">
      <div>
        <p class="kicker" data-reveal>{t.archipelago.kicker}</p>
        <h2 id="arch-title" class="section-title" data-reveal>{t.archipelago.title}</h2>
        <p class="section-intro" data-reveal>{t.archipelago.intro}</p>
      </div>

      <div class="arch__controls" data-reveal>
        <div class="arch__filter" role="group" aria-label={t.archipelago.filterLabel}>
          <button type="button" data-set-filter="all" aria-pressed="true">{t.archipelago.filterAll}</button>
          <button type="button" data-set-filter="core" aria-pressed="false">{t.archipelago.filterCore}</button>
        </div>
        <ul class="arch__legend">
          <li><span class="buoy-dot buoy-dot--core" aria-hidden="true"></span>{t.archipelago.legendCore}</li>
          <li><span class="buoy-dot" aria-hidden="true"></span>{t.archipelago.legendOther}</li>
        </ul>
      </div>
    </header>

    <ul class="arch__map">
      {
        archipelago.map((cay, i) => {
          const shape = shapes[cay.id];
          return (
            <li class={`cay cay--${cay.id}`} data-reveal style={`--reveal-i:${i % 4}`}>
              <svg class="cay__island" viewBox="0 0 170 96" aria-hidden="true" focusable="false">
                <ellipse cx="86" cy="58" rx="84" ry="34" fill="var(--sea-4)" opacity="0.6" />
                <path d={shape.d} transform="translate(0 4)" fill="var(--ink)" />
                <path d={shape.d} fill={shape.fill} stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round" />
                {cay.id === 'devops' && (
                  <g stroke="var(--ink)" stroke-width="3">
                    {[30, 60, 90, 120].map((x) => (
                      <line x1={x} x2={x} y1="62" y2="84" />
                    ))}
                  </g>
                )}
              </svg>
              <h3 class="cay__name">{t.archipelago.cays[cay.id]}</h3>
              <ul class="cay__buoys">
                {cay.tech.map((x) => (
                  <li class:list={['buoy', { 'buoy--core': x.core }]}>{x.name}</li>
                ))}
              </ul>
            </li>
          );
        })
      }
      <li class="arch__compass" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="54" fill="none" stroke="var(--cream)" stroke-width="2" stroke-dasharray="4 6"></circle>
          <circle cx="60" cy="60" r="40" fill="var(--sea-7)" stroke="var(--cream)" stroke-width="3"></circle>
          <g class="arch__needle">
            <path d="M60 22 L68 60 L60 98 L52 60 Z" fill="var(--cream)"></path>
            <path d="M60 22 L68 60 L52 60 Z" fill="var(--coral)"></path>
          </g>
          <circle cx="60" cy="60" r="5" fill="var(--sun)" stroke="var(--ink)" stroke-width="2"></circle>
          <text x="60" y="14" text-anchor="middle" fill="var(--cream)" font-size="12" font-family="var(--font-mono)" font-weight="600">N</text>
        </svg>
      </li>
    </ul>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('#archipielago');
  section?.querySelectorAll<HTMLButtonElement>('[data-set-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      section.dataset.filter = btn.dataset.setFilter;
      section.querySelectorAll('[data-set-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    });
  });
</script>

<style>
  .arch {
    color: var(--cream);
    background:
      repeating-radial-gradient(circle at 78% 30%, transparent 0 46px, rgb(255 255 255 / 0.05) 46px 48px),
      linear-gradient(rgb(255 255 255 / 0.06) 2px, transparent 2px) 0 0 / 100% 120px,
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 2px, transparent 2px) 0 0 / 120px 100%,
      var(--sea-6);
    border-top: var(--outline) solid var(--ink);
  }
  .arch .section-intro {
    color: color-mix(in srgb, var(--cream) 82%, transparent);
  }
  .arch__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 28px;
  }
  .arch__controls {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .arch__filter {
    display: inline-flex;
    padding: 4px;
    background: var(--sea-7);
    border: var(--outline) solid var(--ink);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .arch__filter button {
    padding: 8px 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--cream);
    font: inherit;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .arch__filter button[aria-pressed='true'] {
    background: var(--sun);
    color: var(--ink);
  }
  .arch__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .arch__legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .buoy-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--cream);
    border: 2.5px solid var(--ink);
  }
  .buoy-dot--core {
    background: var(--sun);
  }

  /* --- mapa --- */
  .arch__map {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px) clamp(20px, 3vw, 40px);
    margin-top: clamp(48px, 7vw, 88px);
  }
  .cay {
    position: relative;
  }
  /* disposición dispersa, como islotes en una carta */
  .cay:nth-child(4n + 2) {
    margin-top: 56px;
  }
  .cay:nth-child(4n + 3) {
    margin-top: 18px;
  }
  .cay:nth-child(4n + 4) {
    margin-top: 72px;
  }
  .cay__island {
    width: min(100%, 200px);
    height: auto;
    transition: transform 0.4s var(--ease-bounce);
  }
  .cay:hover .cay__island {
    transform: translateY(-6px) rotate(-2deg);
  }
  .cay__name {
    margin-top: 6px;
    font-size: 1.3rem;
  }
  .cay__buoys {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
  }
  .buoy {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px 4px 7px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.4;
    box-shadow: 2px 2px 0 var(--ink);
    transition:
      transform 0.25s var(--ease-bounce),
      opacity 0.3s;
  }
  .buoy::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--sea-2);
  }
  .buoy--core {
    background: var(--sun);
    font-weight: 600;
  }
  .buoy--core::before {
    background: var(--coral);
  }
  .buoy:hover {
    transform: translateY(-3px);
  }
  [data-filter='core'] .buoy:not(.buoy--core) {
    display: none;
  }

  .arch__compass {
    display: grid;
    place-items: center;
    align-self: center;
  }
  .arch__compass svg {
    width: clamp(100px, 10vw, 140px);
  }
  .arch__needle {
    transform-origin: 60px 60px;
    animation: needle 8s ease-in-out infinite;
  }
  @keyframes needle {
    0%,
    100% {
      transform: rotate(-12deg);
    }
    50% {
      transform: rotate(18deg);
    }
  }

  @media (max-width: 1000px) {
    .arch__map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cay:nth-child(n) {
      margin-top: 0;
    }
    .cay:nth-child(2n) {
      margin-top: 40px;
    }
  }
  @media (max-width: 560px) {
    .arch__map {
      grid-template-columns: 1fr;
    }
    .cay:nth-child(2n) {
      margin-top: 0;
    }
    .cay {
      display: grid;
      grid-template-columns: 96px 1fr;
      column-gap: 14px;
      align-items: start;
    }
    .cay__island {
      grid-row: span 2;
      width: 96px;
    }
    .cay__name {
      margin-top: 0;
    }
    .cay__buoys {
      margin-top: 8px;
    }
    .arch__compass {
      display: none;
    }
  }
</style>
