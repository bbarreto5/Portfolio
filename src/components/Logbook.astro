---
import type { Content } from '../data/profile';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const sequential = t.logbook.waypoints.filter((w) => !w.parallel);
const parallel = t.logbook.waypoints.filter((w) => w.parallel);
---

<section class="logbook section" id="bitacora" aria-labelledby="logbook-title">
  <div class="wrap">
    <header class="logbook__head">
      <p class="kicker" data-reveal>{t.logbook.kicker}</p>
      <h2 id="logbook-title" class="section-title" data-reveal>{t.logbook.title}</h2>
      <p class="section-intro" data-reveal>{t.logbook.intro}</p>
    </header>

    <ol class="route">
      {
        sequential.map((w, i) => (
          <li class:list={['wp', `wp--${i % 2 ? 'right' : 'left'}`, `wp--${w.kind}`]} data-reveal>
            <span class="wp__buoy" aria-hidden="true" />
            <article class="wp__card">
              <p class="wp__meta">
                <span class="wp__num">WP-{String(i + 1).padStart(2, '0')}</span>
                <time>{w.period}</time>
              </p>
              <h3 class="wp__org">{w.org}</h3>
              <p class="wp__role">{w.role}</p>
              <p class="wp__summary">{w.summary}</p>
              {w.tech && (
                <ul class="wp__tech" aria-label="Stack">
                  {w.tech.map((x) => <li class="tag">{x}</li>)}
                </ul>
              )}
            </article>
          </li>
        ))
      }

      <li class="route__fork" data-reveal>
        <span class="route__fork-label">{t.logbook.parallelNote}</span>
        <ol class="route__parallel">
          {
            parallel.map((w, i) => (
              <li class:list={['wp', 'wp--parallel', { 'wp--current': w.current }]}>
                <span class="wp__buoy" aria-hidden="true" />
                <article class="wp__card">
                  <p class="wp__meta">
                    <span class="wp__num">WP-{String(sequential.length + i + 1).padStart(2, '0')}</span>
                    <time>{w.period}</time>
                  </p>
                  <h3 class="wp__org">{w.org}</h3>
                  <p class="wp__role">{w.role}</p>
                  <p class="wp__summary">{w.summary}</p>
                  {w.tech && (
                    <ul class="wp__tech" aria-label="Stack">
                      {w.tech.map((x) => <li class="tag">{x}</li>)}
                    </ul>
                  )}
                </article>
              </li>
            ))
          }
        </ol>
      </li>
    </ol>
  </div>
</section>

<style>
  .logbook {
    background:
      radial-gradient(circle, color-mix(in srgb, var(--ink) 16%, transparent) 1.5px, transparent 2px) 0 0 / 28px 28px,
      var(--sea-1);
    border-top: var(--outline) solid var(--ink);
  }
  .logbook__head {
    max-width: 720px;
  }

  .route {
    --line-x: 50%;
    position: relative;
    margin: clamp(48px, 7vw, 88px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 28px;
  }
  /* ruta punteada central */
  .route::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--line-x);
    border-left: 4px dashed var(--ink);
    opacity: 0.55;
    translate: -2px 0;
  }

  .wp {
    position: relative;
    width: calc(50% - 44px);
  }
  .wp--left {
    justify-self: start;
  }
  .wp--right {
    justify-self: end;
  }
  /* las tarjetas alternas se solapan en altura para que la ruta se lea continua */
  .wp:not(.wp--parallel) + .wp {
    margin-top: -96px;
  }
  .wp__buoy {
    position: absolute;
    top: 26px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--coral);
    border: var(--outline) solid var(--ink);
    box-shadow: inset 0 -8px 0 var(--cream);
  }
  .wp--left .wp__buoy {
    right: -57px;
  }
  .wp--right .wp__buoy {
    left: -57px;
  }
  .wp--study .wp__buoy {
    background: var(--sun);
  }

  .wp__card {
    padding: 22px 24px;
    background: var(--cream);
    border: var(--outline) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-cel-sm);
    transition:
      transform 0.3s var(--ease-bounce),
      box-shadow 0.3s var(--ease-bounce);
  }
  .wp__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-cel);
  }
  .wp--study .wp__card {
    background: var(--sand);
    border-style: dashed;
  }
  .wp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .wp__num {
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--ink);
    color: var(--cream);
    font-weight: 600;
  }
  .wp__org {
    margin-top: 12px;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
  }
  .wp__role {
    margin-top: 4px;
    font-weight: 650;
    color: var(--sea-6);
  }
  .wp__summary {
    margin-top: 10px;
    color: var(--ink-soft);
  }
  .wp__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  /* bifurcación: dos rutas en paralelo */
  .route__fork {
    position: relative;
    display: grid;
    gap: 22px;
    padding-top: 12px;
  }
  .route__fork-label {
    position: relative;
    z-index: 1;
    justify-self: center;
    padding: 6px 16px;
    background: var(--sun);
    border: var(--outline) solid var(--ink);
    border-radius: 999px;
    box-shadow: var(--shadow-cel-sm);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .route__parallel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 88px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wp--parallel {
    width: auto;
  }
  .wp--parallel .wp__buoy {
    top: -38px;
    left: 50%;
    translate: -50% 0;
  }
  .wp--current .wp__card {
    background: var(--sun);
  }
  .wp--current .wp__role {
    color: var(--ink);
  }
  .wp--current .wp__summary {
    color: var(--ink);
  }

  @media (max-width: 820px) {
    .route {
      --line-x: 13px;
    }
    .wp:not(.wp--parallel) + .wp {
      margin-top: 0;
    }
    .wp,
    .wp--left,
    .wp--right {
      width: auto;
      justify-self: stretch;
      margin-left: 46px;
    }
    .wp--left .wp__buoy,
    .wp--right .wp__buoy {
      left: -46px;
      right: auto;
    }
    .route__fork-label {
      justify-self: start;
      margin-left: 46px;
    }
    .route__parallel {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .wp--parallel .wp__buoy {
      top: 26px;
      left: -46px;
      translate: none;
    }
  }
</style>
