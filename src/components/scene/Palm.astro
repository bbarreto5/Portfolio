---
// Palmera cel-shaded. Se usa dentro de un <svg>. (x, y) = base del tronco.
interface Props {
  x: number;
  y: number;
  scale?: number;
  lean?: number;
  delay?: number;
  flip?: boolean;
}
const { x, y, scale = 1, lean = 0, delay = 0, flip = false } = Astro.props;
const fx = flip ? -1 : 1;
---

<g transform={`translate(${x} ${y}) scale(${scale * fx} ${scale})`}>
  <g class="palm" style={`animation-delay:${delay}s`}>
    <!-- tronco -->
    <path
      d={`M-7 0 C ${-4 + lean * 0.3} -60, ${lean * 0.7 - 6} -120, ${lean - 4} -170 L ${lean + 6} -168 C ${lean * 0.7 + 6} -118, ${8 + lean * 0.3} -58, 9 0 Z`}
      fill="var(--wood)"
      stroke="var(--ink)"
      stroke-width="3.5"
      stroke-linejoin="round"></path>
    {
      [30, 62, 94, 126, 152].map((h) => (
        <path
          d={`M${-6 + (lean * h) / 170} ${-h} q 7 4 14 0`}
          fill="none"
          stroke="var(--ink)"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.55"
        />
      ))
    }
    <!-- copa -->
    <g transform={`translate(${lean + 1} -170)`}>
      <path d="M0 0 C 30 -30, 70 -24, 96 6 C 66 -6, 36 -4, 0 0 Z" fill="var(--palm)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"></path>
      <path d="M0 0 C -28 -32, -70 -26, -94 4 C -62 -8, -32 -6, 0 0 Z" fill="var(--palm)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"></path>
      <path d="M0 0 C 20 -44, 52 -60, 74 -58 C 50 -44, 28 -26, 0 0 Z" fill="var(--palm-dark)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"></path>
      <path d="M0 0 C -18 -46, -48 -62, -70 -60 C -46 -46, -26 -28, 0 0 Z" fill="var(--palm-dark)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"></path>
      <path d="M0 0 C 26 6, 54 30, 62 62 C 42 38, 22 20, 0 0 Z" fill="var(--palm-dark)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"></path>
      <path d="M0 0 C -26 8, -52 32, -58 62 C -40 38, -20 20, 0 0 Z" fill="var(--palm)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"></path>
      <path d="M0 0 C 4 -30, 14 -54, 8 -76 C 0 -52, -6 -28, 0 0 Z" fill="var(--palm)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"></path>
      <circle cx="-6" cy="6" r="6.5" fill="var(--wood)" stroke="var(--ink)" stroke-width="3"></circle>
      <circle cx="6" cy="8" r="6.5" fill="var(--wood)" stroke="var(--ink)" stroke-width="3"></circle>
      <circle cx="0" cy="-2" r="5" fill="#a85a2a" stroke="var(--ink)" stroke-width="3"></circle>
    </g>
  </g>
</g>

<style>
  .palm {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: sway 6s ease-in-out infinite;
  }
</style>
