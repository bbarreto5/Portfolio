  <path
    d="M24 78 C 4 78, 4 52, 26 50 C 24 28, 54 20, 70 34 C 78 10, 122 6, 132 32 C 146 18, 178 24, 176 48 C 204 46, 212 78, 188 78 Z"
    fill="var(--cream)"
    stroke="var(--ink)"
