---
// Satélite: guiño al hilo de la carrera (rastreo satelital → imágenes satelitales).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 200 150" aria-hidden="true" focusable="false">
  <g class="sat">
    <g transform="rotate(-18 100 60)">
      <rect x="10" y="44" width="56" height="32" rx="3" fill="var(--sea-5)" stroke="var(--ink)" stroke-width="3.5"></rect>
      <path d="M28 44v32M47 44v32M10 60h56" stroke="var(--sea-2)" stroke-width="2"></path>
      <rect x="134" y="44" width="56" height="32" rx="3" fill="var(--sea-5)" stroke="var(--ink)" stroke-width="3.5"></rect>
      <path d="M152 44v32M171 44v32M134 60h56" stroke="var(--sea-2)" stroke-width="2"></path>
      <path d="M66 60h14M120 60h14" stroke="var(--ink)" stroke-width="4"></path>
      <rect x="80" y="38" width="40" height="44" rx="6" fill="var(--cream)" stroke="var(--ink)" stroke-width="3.5"></rect>
      <rect x="88" y="48" width="24" height="10" rx="2" fill="var(--sun)" stroke="var(--ink)" stroke-width="2.5"></rect>
      <path d="M100 82 v 12" stroke="var(--ink)" stroke-width="3.5"></path>
      <path d="M88 104 a 14 10 0 0 1 24 0 z" fill="var(--coral)" stroke="var(--ink)" stroke-width="3"></path>
    </g>
  </g>
  <g fill="none" stroke="var(--cream)" stroke-width="3.5" stroke-linecap="round" class="beam">
    <path d="M96 122 q 10 8 20 0" opacity="0.9"></path>
    <path d="M88 134 q 18 12 36 0" opacity="0.65"></path>
    <path d="M80 146 q 26 14 52 0" opacity="0.4"></path>
  </g>
</svg>

<style>
  .sat {
    transform-box: fill-box;
    transform-origin: center;
    animation: orbit 9s ease-in-out infinite;
  }
  .beam {
    animation: bob 3s ease-in-out infinite;
  }
  @keyframes orbit {
    0%,
    100% {
      transform: translate(0, 0) rotate(-3deg);
    }
    50% {
      transform: translate(6px, -8px) rotate(3deg);
    }
  }
</style>
